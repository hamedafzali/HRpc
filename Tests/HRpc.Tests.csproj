<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
<PropertyGroup>
  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HRpc.csproj" />
  </ItemGroup>

  <!-- The released 1.3.2 package, downloaded (not referenced) so CompatibilityTests can load it
       into its own AssemblyLoadContext and run old and new peers against each other. -->
  <PropertyGroup>
    <HRpcCompatVersion>1.3.2</HRpcCompatVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageDownload Include="HRpc" Version="[$(HRpcCompatVersion)]" />
  </ItemGroup>
  <Target Name="CopyHRpcCompatAssembly" AfterTargets="Build" Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net48'">
    <Copy SourceFiles="$(NuGetPackageRoot)hrpc/$(HRpcCompatVersion)/lib/net8.0/HRpc.dll"
          DestinationFolder="$(OutDir)compat/v$(HRpcCompatVersion)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
